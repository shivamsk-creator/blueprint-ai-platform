# =============================================================================
# Blueprint AI — Environment Variables Contract
# Copy to .env.local (never commit .env.local or production secrets).
# =============================================================================

# --- Public Browser + Server Configuration (Supabase) ---
# Supabase project URL (e.g., https://<project-ref>.supabase.co or http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key; relies strictly on PostgreSQL RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server & Worker Only (NEVER expose to browser / NEXT_PUBLIC_*) ---
# Privileged service-role key for worker queue consumption, secret vault access, and server audit writes
SUPABASE_SERVICE_ROLE_KEY=
# Direct PostgreSQL connection string (optional, used for migrations or direct pgmq administration)
DATABASE_URL=
# 32-byte base64 or 64-char hex master encryption key for AES-256-GCM encryption of AI provider API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SECRETS_ENCRYPTION_KEY=
# Active key version identifier for key rotation (e.g. v1, v2)
AI_SECRETS_KEY_VERSION=v1
# Optional comma-separated legacy keys for zero-downtime rotation: "v0:<hex>"
AI_SECRETS_LEGACY_KEYS=

# Canonical application URL for auth callbacks, invitation links, and CORS checks
APP_URL=http://localhost:3000

# --- Worker Runtime Configuration (apps/worker only) ---
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=4001
AI_PROVIDER_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# --- Private Supabase Storage Buckets ---
STORAGE_BUCKET_PROJECT_FILES=project-files
STORAGE_BUCKET_EXPORTS=exports

# --- Observability (Optional) ---
SENTRY_DSN=

# --- Local Development Preview Mode (Development/Test Only) ---
# Set to "true" to run locally with the isolated in-memory workspace store before connecting Supabase
BLUEPRINT_DEMO_MODE=true
